{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"Jwt": {
		"Issuer": "https://auth-service",
		"Audience": "cinema-users",
		"Key": "SuperSecretSigningKey123"
	},
	"ReverseProxy": {
		"Routes": {
			"auth": {
				"ClusterId": "auth-cluster",
				"Match": { "Path": "/auth/{**catch-all}" },
				"Metadata" : {"AuthRequired": "false"},
				"Transforms": [{ "PathRemovePrefix": "/auth" }]
			},
			"movies": {
				"ClusterId": "movies-cluster",
				"Match": { "Path": "/movies/{**catch-all}" },
				"Metadata" : {"AuthRequired": "true"},
				"Transforms": [{ "PathRemovePrefix": "/movies" }]
			}
		},
		"Clusters": {
			"auth-cluster": {
				"Destinations": {
					"auth": { "Address": "http://auth-service/" }
				}
			},
			"movies-cluster": {
				"Destinations": {
					"movies": { "Address": "http://movies-service/" }
				}
			}
		}
	}
}
