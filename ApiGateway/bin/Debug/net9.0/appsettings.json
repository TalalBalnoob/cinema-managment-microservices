{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"Jwt": {
		"Issuer": "https://auth-service",
		"Audience": "cinema-users",
		"Key": "SuperSecretSigningKey123"
	},
	"ReverseProxy": {
		"Routes": {
			"auth": {
				"ClusterId": "auth-cluster",
				"Match": { "Path": "/auth/{**catch-all}" }
			},
			"movies": {
				"ClusterId": "movies-cluster",
				"Match": { "Path": "/movies/{**catch-all}" }
			}
		},
		"Clusters": {
			"auth-cluster": { "Destinations": { "auth": { "Address": "http://auth-service:8080/" } } },
			"movies-cluster": { "Destinations": { "movies": { "Address": "http://movies-service:8080/" } } }
		}
	}
}
